START hilow_game

    DISPLAY "Welcome to the higher/lower game Bella!"

    # Establish a valid guessing range.

    REPEAT

        DISPLAY "Enter the smallest number:"
        INPUT smallest_number

        DISPLAY "Enter the biggest number:"
        INPUT biggest_number

        IF smallest_number >= biggest_number THEN
            DISPLAY "The smallest number must be less than the biggest number."
        END IF

    UNTIL smallest_number < biggest_number

    # Establish the number the player is trying to guess.

    SET random_number = RANDOM NUMBER between smallest_number and biggest_number

    # Play the game.





    DISPLAY "Great, now guess a number between ", smallest_number,
            " and ", biggest_number

    INPUT guess

    WHILE guess < smallest_number OR guess > biggest_number
        DISPLAY "Oops! The smallest number must be less than the biggest number."
        INPUT guess
    END WHILE

    WHILE guess != random_number

        IF guess < random_number THEN
            DISPLAY "Sorry, that's too low. Guess again."

        ELSE
            DISPLAY "Sorry, that's too high. Guess again."
        END IF

        DISPLAY "Try again! Pick a number between the smallest and biggest numbers."
        INPUT guess

        WHILE guess < smallest_number OR guess > biggest_number
            DISPLAY "Oops! The smallest number must be less than the biggest number."
            INPUT guess
        END WHILE

    END WHILE

    DISPLAY "Awesome! You got it!"

END hilow_game
